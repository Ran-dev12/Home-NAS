{
  "name": "homenas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A home NAS on a Windows PC with an external SSD: file browser, photo timeline, iPhone backup via Shortcuts, share links, multi-user.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=server server/index.ts",
    "build": "vite build",
    "start": "node server/index.ts --prod",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "busboy": "^1.6.0",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
